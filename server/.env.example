# Copy to .env for local development. On Railway, set these as service variables.

# Public URL of this server (no trailing slash). Storefronts and download links use it.
PUBLIC_URL=http://localhost:8080
PORT=8080

# Where the SQLite database and uploaded/generated files live. On Railway, mount a volume here.
DATA_DIR=./data

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Model used for photo analysis and product generation
CLAUDE_MODEL=claude-sonnet-5-5
# Model behind the in-app store assistant (multi-step agent with tools)
AGENT_MODEL=claude-fable-5-1

# Stripe (your platform account). Use test keys (sk_test_...) until you go live.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Connect webhook endpoint pointing at {PUBLIC_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Percentage of each sale Snapfront keeps (0 to disable). Taken as a Stripe application fee.
PLATFORM_FEE_PERCENT=5

# Random 32+ character string used to sign download links. Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=change-me

# Optional: send buyers their download link by email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Snapfront <orders@yourdomain.com>
