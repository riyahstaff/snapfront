{
  "expo": {
    "name": "Snapfront",
    "slug": "snapfront",
    "scheme": "snapfront",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Snap a photo of a product and get a full product page with Stripe checkout, or generate best-selling digital products and sell them from your own storefront.",
    "ios": {
      "bundleIdentifier": "com.sidebanc.snapfront",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.sidebanc.snapfront",
      "adaptiveIcon": {
        "backgroundColor": "#2C47F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2C47F5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Snapfront uses your photos so you can turn a product picture into a product page.",
          "cameraPermission": "Snapfront uses the camera so you can photograph a product and turn it into a product page.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Snapfront saves your marketing posts and videos to your photos.",
          "savePhotosPermission": "Snapfront saves your marketing posts and videos to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://snapfront.app",
      "eas": {
        "projectId": "d9ef2157-0771-455a-b3c4-867036f70222"
      },
      "router": {}
    },
    "owner": "snapfront"
  }
}
